ADMIN_EMAILS=admin@example.com
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_EXPOSE_LINK=0
EMAIL_VERIFICATION_EXPOSE_LINK=0
EMAIL_VERIFICATION_LOGIN_BLOCK=0
TRUST_PROXY_HEADERS=0
ADMIN_API_TOKEN=

# Email delivery
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=MatchIQ Coach AI

# OpenAI services
OPENAI_API_KEY=
