# Core application (optional locally; defaults are available)
APP_PUBLIC_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Optional locally: leave empty to use the ignored local SQLite database.
# Required on Railway/production. Example only, never commit a real password.
DATABASE_URL=
PORT=8000

# Authentication and authorization
# Required on Railway/production for stable sessions (minimum 32 characters).
# Optional locally: the app creates an ignored local secret when omitted.
JWT_SECRET_KEY=
JWT_SECRET_FILE=storage/.jwt_secret
SECRET_KEY=
OWNER_EMAILS=owner@example.com
ADMIN_EMAILS=admin@example.com
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_EXPOSE_LINK=0
EMAIL_VERIFICATION_EXPOSE_LINK=0
EMAIL_VERIFICATION_LOGIN_BLOCK=0
TRUST_PROXY_HEADERS=0
ADMIN_API_TOKEN=

# Email delivery (optional)
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=MatchIQ Coach AI

# OpenAI services (optional; required only for AI provider calls)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_VIDEO_MODEL=gpt-4.1-mini
OPENAI_TACTICAL_ASSISTANT_MODEL=gpt-4o-mini

# Football data (optional)
API_FOOTBALL_KEY=

# Stripe (optional; required only for paid checkout/webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Runtime and public feature flags (optional)
BACKGROUND_REFRESH_MAX_WORKERS=10
SCOUT_PUBLIC_BETA=1
PDF_PUBLIC_BETA=1

# Video AI limits and storage (optional)
VIDEO_REPORT_MAX_FRAMES=6
VIDEO_SELECTION_MAX_FRAMES=32
VIDEO_REPORT_MAX_FRAME_CHARS=900000
VIDEO_LIBRARY_DIR=storage/video_library
VIDEO_STORAGE_BACKEND=local
VIDEO_LIBRARY_MAX_UPLOAD_MB=450
VIDEO_IMPORT_TIMEOUT_SECONDS=6
VIDEO_IMPORT_MAX_REDIRECTS=4
VIDEO_HALFTIME_BETA_ENABLED=0
VIDEO_HALFTIME_BETA_USER_IDS=
VIDEO_HALFTIME_BETA_EMAILS=

# Optional cloud integrations
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Vision Engine research (optional, never required by the web runtime)
MATCHIQ_V3_DATASET=
